---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero/hero.astro";
import FacultyTiles from "../components/hero/faculty-tiles.astro";
import Wartungsarbeiten from "../components/wartungsarbeiten/wartungsarbeiten.astro";
import SponsorCard from "../components/sponsor/sponsor-card.astro";
import CampusImage from "../assets/background/Campus-Berliner-Tor-2018.jpg";
---

<Layout title="Start - Orientierungseinheit EMI & INF">
  <Hero
    backgroundImage={CampusImage}
    imageAlt="HAW Hamburg Campus Berliner Tor"
    title="Orientierungseinheit"
    subtitle="Herzlich Willkommen an der HAW Hamburg zum Studienstart an den Fakultäten"
  >
    <FacultyTiles />
  </Hero>

  <!-- Main Content Container -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 w-full space-y-8">
    <Wartungsarbeiten />
    <SponsorCard />
  </div>
</Layout>
