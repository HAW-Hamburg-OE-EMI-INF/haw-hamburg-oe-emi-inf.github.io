---
import FAQContainer from "../components/faq/faq-container.astro";
import Hero from "../components/hero/hero.astro";
import FAQContent from "../data/faq-content.astro";
import Layout from "../layouts/Layout.astro";

import "../styles/faq.css";
---

<Layout
  description="Häufig gestellte Fragen (FAQ) zur Orientierungseinheit an der HAW Hamburg für die Fakultäten EMI und INF."
  title="FAQ - Orientierungseinheit EMI & INF"
>
  <Hero
    compact
    subtitle="Antworten auf die wichtigsten Fragen zur Orientierungseinheit und deinem Studienstart an der HAW Hamburg"
    title="Häufige Fragen (FAQ)"
  />

  <div class="mx-auto w-full max-w-4xl space-y-10 px-4 py-10 sm:px-6">
    <FAQContainer>
      <FAQContent />
    </FAQContainer>
  </div>
</Layout>
