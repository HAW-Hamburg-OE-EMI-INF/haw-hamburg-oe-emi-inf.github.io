---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero/hero.astro";
import DegreeCard from "../components/degree/degree-card.astro";

interface Program {
  short: string;
  name: string;
  href: string;
}

interface Faculty {
  id: string;
  short: string;
  name: string;
  programs: Program[];
}

const faculties: Faculty[] = [
  {
    id: "emi",
    short: "EMI",
    name: "Elektro-, Medien- und Informationstechnik",
    programs: [
      {
        short: "ET",
        name: "Elektrotechnik und Informationstechnik",
        href: "/degree/et",
      },
      {
        short: "IE",
        name: "Information Engineering",
        href: "/degree/ie",
      },
      {
        short: "MT",
        name: "Medientechnik",
        href: "/degree/mt",
      },
      {
        short: "REE",
        name: "Regenerative Energiesysteme und Energiemanagement",
        href: "/degree/ree",
      },
    ],
  },
  {
    id: "inf",
    short: "INF",
    name: "Informatik und Digitale Gesellschaft",
    programs: [
      {
        short: "AI",
        name: "Angewandte Informatik",
        href: "/degree/ai",
      },
      {
        short: "ITS",
        name: "Informatik Technischer Systeme",
        href: "/degree/its",
      },
      {
        short: "ECS",
        name: "European Computer Science",
        href: "/degree/ecs",
      },
      {
        short: "WI",
        name: "Wirtschaftsinformatik",
        href: "/degree/wi",
      },
      {
        short: "MI",
        name: "Medieninformatik",
        href: "/degree/mi",
      },
      {
        short: "BIM",
        name: "Bibliotheks- und Informationsmanagement",
        href: "/degree/bim",
      },
    ],
  },
];
---

<Layout title="Studiengänge - Orientierungseinheit EMI & INF">
  <Hero title="Studiengänge" compact />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 w-full space-y-10">
    <!-- Quick Links zu den Fakultäten -->
    <nav
      aria-label="Fakultätsauswahl"
      class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs"
    >
      <p
        class="text-xs font-semibold uppercase tracking-wider text-haw-700 mb-3"
      >
        Direkt zur Fakultät springen
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          faculties.map((fac) => (
            <a
              href={`#${fac.id}`}
              class="flex items-center gap-3 p-3.5 rounded-xl bg-slate-50 hover:bg-haw-50 border border-slate-200/80 hover:border-haw-300 transition-all duration-200 group"
            >
              <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-md bg-haw-700 text-white font-bold text-xs tracking-wider shrink-0">
                {fac.short}
              </span>
              <span class="text-xs sm:text-sm font-semibold text-slate-800 group-hover:text-haw-700 transition-colors leading-snug">
                {fac.name}
              </span>
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Fakultäten mit Studiengängen -->
    {
      faculties.map((fac) => (
        <section id={fac.id} class="space-y-4 scroll-mt-20">
          <div class="border-b border-slate-200 pb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-haw-100 text-haw-800">
                {fac.short}
              </span>
              <h2 class="text-lg font-bold text-slate-900">
                Fakultät {fac.name}
              </h2>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {fac.programs.map((prog) => (
              <DegreeCard {...prog} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
