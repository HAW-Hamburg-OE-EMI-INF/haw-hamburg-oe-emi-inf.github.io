---
import Hero from "../../components/hero/hero.astro";
import StudiengangCard from "../../components/studiengang/studiengang-card.astro";
import { faculties } from "../../data/faculty";
import { studiengaenge, studiengaengeEMI, studiengaengeINF } from "../../data/studiengaenge";
import Layout from "../../layouts/Layout.astro";
import type { FacultyEntry, StudiengangEntry } from "../../types/types";

interface Entry {
  facultyEntry: FacultyEntry;
  studiengaenge: StudiengangEntry[];
}

const entries: Entry[] = [
  {
    facultyEntry: faculties.EMI,
    studiengaenge: studiengaengeEMI,
  },
  {
    facultyEntry: faculties.INF,
    studiengaenge: studiengaengeINF.filter((prog) => prog !== studiengaenge["M-INF"]),
  },
];
---

<Layout title="Studiengänge - Orientierungseinheit EMI & INF">
  <Hero compact title="Studiengänge" />

  <div class="mx-auto w-full max-w-4xl space-y-10 px-4 py-10 sm:px-6">
    <!-- Quick Links zu den Fakultäten -->
    <nav
      aria-label="Fakultätsauswahl"
      class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5"
    >
      <p class="text-haw-700 mb-3 text-xs font-semibold tracking-wider uppercase">
        Direkt zur Fakultät springen
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {entries.map((entry) => (
          <a
            class="hover:bg-haw-50 hover:border-haw-300 group flex items-center gap-3 rounded-xl border border-slate-200/80 bg-slate-50 p-3.5 transition-all duration-200"
            href={`#${entry.facultyEntry.short.toLowerCase()}`}
          >
            <span class="bg-haw-700 inline-flex shrink-0 items-center justify-center rounded-md px-2.5 py-1 text-xs font-bold tracking-wider text-white">
              {entry.facultyEntry.short}
            </span>
            <span class="group-hover:text-haw-700 text-xs leading-snug font-semibold text-slate-800 transition-colors sm:text-sm">
              {entry.facultyEntry.name}
            </span>
          </a>
        ))}
      </div>
    </nav>

    <!-- Fakultäten mit Studiengängen -->
    {entries.map((entry) => (
      <section class="scroll-mt-20 space-y-4" id={entry.facultyEntry.short.toLowerCase()}>
        <div class="border-b border-slate-200 pb-2">
          <div class="flex items-center gap-2">
            <span class="bg-haw-100 text-haw-800 rounded px-2 py-0.5 text-xs font-bold tracking-wider uppercase">
              {entry.facultyEntry.short}
            </span>
            <h2 class="text-lg font-bold text-slate-900">Fakultät {entry.facultyEntry.name}</h2>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {entry.studiengaenge.map((studiengang) => (
            <StudiengangCard studiengang={studiengang} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
