---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/hero/hero.astro";
import StudiengangCard from "../../components/studiengang/studiengang-card.astro";
import type { FacultyEntry, StudiengangEntry } from "../../types/types";
import { faculties } from "../../data/faculty";
import {
  studiengaenge,
  studiengaengeEMI,
  studiengaengeINF,
} from "../../data/studiengaenge";

interface Entry {
  facultyEntry: FacultyEntry;
  studiengaenge: StudiengangEntry[];
}

const entries: Entry[] = [
  {
    facultyEntry: faculties.EMI,
    studiengaenge: studiengaengeEMI,
  },
  {
    facultyEntry: faculties.INF,
    studiengaenge: studiengaengeINF.filter(
      (prog) => prog !== studiengaenge["M-INF"],
    ),
  },
];
---

<Layout title="Studiengänge - Orientierungseinheit EMI & INF">
  <Hero title="Studiengänge" compact />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 w-full space-y-10">
    <!-- Quick Links zu den Fakultäten -->
    <nav
      aria-label="Fakultätsauswahl"
      class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs"
    >
      <p
        class="text-xs font-semibold uppercase tracking-wider text-haw-700 mb-3"
      >
        Direkt zur Fakultät springen
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          entries.map((entry) => (
            <a
              href={`#${entry.facultyEntry.short.toLowerCase()}`}
              class="flex items-center gap-3 p-3.5 rounded-xl bg-slate-50 hover:bg-haw-50 border border-slate-200/80 hover:border-haw-300 transition-all duration-200 group"
            >
              <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-md bg-haw-700 text-white font-bold text-xs tracking-wider shrink-0">
                {entry.facultyEntry.short}
              </span>
              <span class="text-xs sm:text-sm font-semibold text-slate-800 group-hover:text-haw-700 transition-colors leading-snug">
                {entry.facultyEntry.name}
              </span>
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Fakultäten mit Studiengängen -->
    {
      entries.map((entry) => (
        <section
          id={entry.facultyEntry.short.toLowerCase()}
          class="space-y-4 scroll-mt-20"
        >
          <div class="border-b border-slate-200 pb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-haw-100 text-haw-800">
                {entry.facultyEntry.short}
              </span>
              <h2 class="text-lg font-bold text-slate-900">
                Fakultät {entry.facultyEntry.name}
              </h2>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {entry.studiengaenge.map((studiengang) => (
              <StudiengangCard studiengang={studiengang} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
