---
import "../styles/global.css";
import Footer from "../components/footer/footer.astro";
import Header from "../components/header/header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Orientierungseinheit EMI & INF - HAW Hamburg",
  description = "Offizielle Orientierungseinheit der Fakultät Elektro-, Medien- und Informationstechnik sowie der Fakultät Informatik und Digitale Gesellschaft an der HAW Hamburg.",
} = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
  </head>
  <body class="selection:bg-haw-200 selection:text-haw-900 flex min-h-screen flex-col bg-slate-50 text-slate-800 antialiased">
    <Header />

    <main class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />
  </body>
</html>
