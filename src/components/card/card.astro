---
import type { HTMLTag } from "astro/types";

export interface Props {
  variant?: "white" | "default" | "haw" | "primary" | "dark" | "muted";
  padding?: "none" | "sm" | "md" | "lg";
  rounded?: "none" | "md" | "lg" | "xl" | "2xl" | "3xl";
  class?: string;
  as?: HTMLTag;
  [key: string]: any;
}

const {
  variant = "white",
  padding = "lg",
  rounded = "2xl",
  class: className = "",
  as: Tag = "div",
  ...rest
} = Astro.props;

const variantClasses: Record<string, string> = {
  white: "bg-white border border-slate-200 shadow-xs text-slate-900",
  default: "bg-white border border-slate-200 shadow-xs text-slate-900",
  haw: "bg-haw-700 text-white shadow-md",
  primary: "bg-haw-700 text-white shadow-md",
  dark: "bg-haw-800/80 text-white border border-haw-600/40 shadow-xs",
  muted: "bg-slate-50 border border-slate-200 text-slate-800",
};

const paddingClasses: Record<string, string> = {
  none: "",
  sm: "p-4",
  md: "p-5 sm:p-6",
  lg: "p-6 sm:p-8",
};

const roundedClasses: Record<string, string> = {
  none: "rounded-none",
  md: "rounded-md",
  lg: "rounded-lg",
  xl: "rounded-xl",
  "2xl": "rounded-2xl",
  "3xl": "rounded-3xl",
};
---

<Tag
  class:list={[
    roundedClasses[rounded] ?? "rounded-2xl",
    paddingClasses[padding] ?? "p-6 sm:p-8",
    variantClasses[variant] ?? variantClasses.white,
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
