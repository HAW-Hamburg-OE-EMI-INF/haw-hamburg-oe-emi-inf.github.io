---
export interface Props {
  variant?: "white" | "default" | "haw" | "primary" | "dark" | "muted";
  heading?: string;
  headingTrailingIcon?: string;
  class?: string;
}

const {
  variant = "white",
  heading,
  headingTrailingIcon,
  class: className = "",
} = Astro.props as Props;

const variantClasses: Record<string, string> = {
  white: "bg-white border border-slate-200 shadow-xs text-slate-900",
  default: "bg-white border border-slate-200 shadow-xs text-slate-900",
  haw: "bg-haw-700 text-white shadow-md",
  primary: "bg-haw-700 text-white shadow-md",
  dark: "bg-haw-800/80 text-white border border-haw-600/40 shadow-xs",
  muted: "bg-slate-50 border border-slate-200 text-slate-800",
};
---

<div
  class:list={["rounded-2xl p-6 sm:p-8", variantClasses[variant], className]}
>
  {
    (heading || headingTrailingIcon) && (
      <div class="flex items-center gap-3 mb-4">
        {headingTrailingIcon && (
          <div class="w-10 h-10 rounded-lg bg-white/15 flex items-center justify-center text-white shrink-0 [&>svg]:w-6 [&>svg]:h-6">
            <Fragment set:html={headingTrailingIcon} />
          </div>
        )}
        {heading && <h2 class="text-2xl font-bold">{heading}</h2>}
      </div>
    )
  }
  <slot />
</div>
