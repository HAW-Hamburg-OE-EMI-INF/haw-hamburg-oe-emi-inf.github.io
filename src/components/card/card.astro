---
import type { SvgComponent } from "astro/types";

export interface Props {
  variant?: "white" | "default" | "haw" | "primary" | "dark" | "muted";
  heading?: string;
  headingTrailingIcon?: SvgComponent;
  class?: string;
}

const {
  variant = "white",
  heading,
  headingTrailingIcon: HeadingTrailingIcon,
  class: className = "",
} = Astro.props as Props;

const variantClasses: Record<string, string> = {
  white: "bg-white border border-slate-200 shadow-xs text-slate-900",
  default: "bg-white border border-slate-200 shadow-xs text-slate-900",
  haw: "bg-haw-700 text-white shadow-md",
  primary: "bg-haw-700 text-white shadow-md",
  dark: "bg-haw-800/80 text-white border border-haw-600/40 shadow-xs",
  muted: "bg-slate-50 border border-slate-200 text-slate-800",
};
---

<div class:list={["rounded-2xl p-6 sm:p-8", variantClasses[variant], className]}>
  {(heading || HeadingTrailingIcon) && (
    <div class="mb-4 flex items-center gap-3">
      {HeadingTrailingIcon && (
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/15 text-white">
          <HeadingTrailingIcon class="h-6 w-6" />
        </div>
      )}
      {heading && <h2 class="text-2xl font-bold">{heading}</h2>}
    </div>
  )}
  <slot />
</div>
