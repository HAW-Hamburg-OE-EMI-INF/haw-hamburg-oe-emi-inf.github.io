---
import type { RoadmapDay } from "../../types/types";

export interface Props {
  day: RoadmapDay;
  isFirst?: boolean;
  isLast?: boolean;
}

const { day, isFirst = false, isLast = false } = Astro.props as Props;
---

<div class="flex w-[calc(100vw-4.5rem)] max-w-60 shrink-0 snap-start flex-col lg:w-auto lg:max-w-none lg:min-w-0 lg:flex-1 lg:shrink">
  <div class="flex flex-1 flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-xs transition-shadow duration-200 hover:shadow-sm">
    <div class="bg-haw-700 px-3 py-2.5 text-center text-white">
      <h4 class="text-base font-bold tracking-wide sm:text-lg">{day.weekday}</h4>
    </div>

    <div class="border-b border-slate-200/80 bg-slate-100/90 px-3.5 py-2.5 text-xs sm:text-sm">
      <div class="grid grid-cols-[3.25rem_1fr] gap-x-2 gap-y-1">
        <span class="font-bold text-slate-900">Start</span>
        <span class="font-medium text-slate-800">{day.start}</span>
        <span class="font-bold text-slate-900">Ende</span>
        <span class="font-medium text-slate-800">{day.end}</span>
      </div>
    </div>

    <div class="flex-1 px-3.5 py-3">
      <ul class="space-y-2 text-xs leading-snug text-slate-700 sm:text-[13px]">
        {day.items.map((item) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="bg-haw-600 mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" />
            <span class="min-w-0 flex-1 wrap-break-word">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    {day.eveningProgram && (
      <div class="border-t border-slate-200/80 bg-slate-100/80 px-3.5 py-3 text-xs leading-snug sm:text-[13px]">
        <p class="text-haw-800 mb-1 text-[11px] font-bold tracking-wider uppercase">
          Abendprogramm:
        </p>
        <p class="font-semibold text-slate-700">{day.eveningProgram}</p>
      </div>
    )}
  </div>

  <div class="relative flex flex-col items-center">
    <span
      aria-hidden="true"
      class="z-10 -mt-1.5 h-3 w-3 rounded-full border-2 border-slate-400 bg-white"
    />

    <span aria-hidden="true" class="h-5 border-l-2 border-dashed border-slate-300" />

    <div class="relative flex w-full items-center justify-center">
      {!isFirst && (
        <span
          aria-hidden="true"
          class="absolute top-1/2 right-1/2 -left-3 h-0.5 -translate-y-1/2 bg-slate-300 sm:-left-4"
        />
      )}
      {!isLast && (
        <span
          aria-hidden="true"
          class="absolute top-1/2 -right-3 left-1/2 h-0.5 -translate-y-1/2 bg-slate-300 sm:-right-4"
        />
      )}
      <span
        aria-hidden="true"
        class="border-haw-600 relative z-10 h-4 w-4 rounded-full border-[3px] bg-white shadow-2xs"
      />
    </div>

    <span class="mt-1.5 font-mono text-sm font-bold text-slate-700">{day.date}</span>
  </div>
</div>
