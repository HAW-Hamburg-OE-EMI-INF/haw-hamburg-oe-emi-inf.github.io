---
import type { StudiengangEntry } from "../../types/types";

export interface Props {
  title: string;
  studiengaenge: StudiengangEntry[];
}

const { title, studiengaenge } = Astro.props;
---

<div class="bg-haw-900/85 border-haw-700/50 rounded-xl border p-5">
  <h3 class="text-haw-200 mb-3 text-sm font-semibold tracking-wider uppercase">{title}</h3>
  <div class="grid grid-cols-1 gap-2.5 text-sm sm:grid-cols-2 sm:text-base">
    {studiengaenge.map((item) => (
      <div class="flex items-start gap-2">
        <span class="bg-haw-300 mt-2 h-2 w-2 shrink-0 rounded-full" aria-hidden="true" />
        <p class="leading-snug font-medium text-white">
          {item.name}
          <span class="text-haw-200 ml-1 font-mono text-xs whitespace-nowrap">({item.degree})</span>
        </p>
      </div>
    ))}
  </div>
</div>
