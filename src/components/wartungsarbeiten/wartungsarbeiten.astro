---
import Card from "../card/card.astro";
import infoIcon from "../../assets/icons/info.svg?raw";
import StudiengaengeBox, { type Studiengang } from "./studiengaenge-box.astro";

const studiengaengeEMI: Studiengang[] = [
  { name: "Elektrotechnik und Informationstechnik", degree: "B.Sc." },
  { name: "Information Engineering", degree: "B.Sc." },
  { name: "Medientechnik", degree: "B.Sc." },
  {
    name: "Regenerative Energiesysteme und Energiemanagement",
    degree: "B.Sc.",
  },
  // { name: "Automatisierung", degree: "M.Sc." },
  // { name: "Information and Communications Engineering", degree: "M.Sc." },
  // { name: "Microelectronic Systems", degree: "M.Sc." },
  // { name: "Zeitabhängige Medien / Sound – Vision", degree: "M.A." },
];

const studiengaengeINF: Studiengang[] = [
  { name: "Angewandte Informatik", degree: "B.Sc." },
  { name: "Informatik Technischer Systeme", degree: "B.Sc." },
  { name: "European Computer Science", degree: "B.Sc." },
  { name: "Wirtschaftsinformatik", degree: "B.Sc." },
  { name: "Medieninformatik", degree: "B.Sc." },
  { name: "Bibliotheks- und Informationsmanagement", degree: "B.A." },
  { name: "Master Informatik", degree: "M.Sc." },
];
---

<Card
  variant="haw"
  heading="Wichtige Informationen"
  headingTrailingIcon={infoIcon}
>
  <p class="text-haw-100 text-base sm:text-lg mb-6 leading-relaxed">
    Auf dieser Seite sind die Informationen für die Orientierungseinheit <strong
      >EMI</strong
    >¹ und <strong>INF</strong>² kurz vor Semesterbeginn zu finden.
  </p>

  <div class="space-y-4">
    <StudiengaengeBox
      title="¹ Studiengänge der Fakultät Elektro-, Medien- und Informationstechnik:"
      studiengaenge={studiengaengeEMI}
    />

    <StudiengaengeBox
      title="² Studiengänge der Fakultät Informatik und Digitale Gesellschaft:"
      studiengaenge={studiengaengeINF}
    />
  </div>
</Card>
