---
import infoIcon from "../../assets/icons/info.svg?raw";
import { studiengaengeEMI, studiengaengeINF } from "../../data/studiengaenge";
import Card from "../card/card.astro";
import StudiengaengeBox from "./studiengaenge-box.astro";
---

<Card variant="haw" heading="Wichtige Informationen" headingTrailingIcon={infoIcon}>
  <p class="text-haw-100 mb-6 text-base leading-relaxed sm:text-lg">
    Auf dieser Seite sind die Informationen für die Orientierungseinheit <strong>EMI</strong>¹ und{" "}
    <strong>INF</strong>² kurz vor Semesterbeginn zu finden.
  </p>

  <div class="space-y-4">
    <StudiengaengeBox
      title="¹ Studiengänge der Fakultät Elektro-, Medien- und Informationstechnik:"
      studiengaenge={studiengaengeEMI}
    />

    <StudiengaengeBox
      title="² Studiengänge der Fakultät Informatik und Digitale Gesellschaft:"
      studiengaenge={studiengaengeINF}
    />
  </div>
</Card>
