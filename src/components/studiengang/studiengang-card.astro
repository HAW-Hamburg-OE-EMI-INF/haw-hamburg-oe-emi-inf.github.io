---
import arrowRightIcon from "../../assets/icons/arrow-right.svg?raw";
import type { StudiengangEntry } from "../../types/types";

export interface Props {
  studiengang: StudiengangEntry;
}

const { studiengang } = Astro.props;
---

<a
  href={`${studiengang.details.base}/${studiengang.details.entryId}`}
  class="group flex items-center justify-between p-4 sm:p-5 bg-white border border-slate-200 rounded-2xl shadow-xs hover:border-haw-500 hover:shadow-md transition-all duration-200 h-full"
>
  <div class="flex items-center gap-3.5 sm:gap-4 min-w-0 flex-1">
    <span
      class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-haw-50 border border-haw-200/80 text-haw-700 font-bold text-sm sm:text-base font-mono shrink-0 group-hover:bg-haw-700 group-hover:text-white group-hover:border-haw-700 transition-colors duration-200"
    >
      {studiengang.short}
    </span>
    <h3
      class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-haw-700 transition-colors duration-200 leading-snug wrap-break-word flex-1 min-w-0"
    >
      {studiengang.name}
    </h3>
  </div>

  <div
    class="text-slate-400 group-hover:text-haw-600 group-hover:translate-x-1 transition-all duration-200 shrink-0 ml-3 [&>svg]:w-5 [&>svg]:h-5"
  >
    <Fragment set:html={arrowRightIcon} />
  </div>
</a>
