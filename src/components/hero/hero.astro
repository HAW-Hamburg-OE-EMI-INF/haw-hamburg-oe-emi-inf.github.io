---
import type { ImageMetadata } from "astro";

interface Props {
  backgroundImage?: ImageMetadata;
  imageAlt?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
  class?: string;
}

const {
  backgroundImage,
  imageAlt,
  title,
  subtitle,
  compact = false,
  class: className = "",
} = Astro.props;
---

<section
  class:list={[
    "relative overflow-hidden text-white flex items-center justify-center",
    compact ? "bg-haw-900 py-8 sm:py-10" : "bg-slate-900 min-h-105 md:min-h-120",
    className,
  ]}
>
  {
    backgroundImage && (
      <div class="absolute inset-0 z-0">
        <img
          src={backgroundImage.src}
          alt={imageAlt}
          class="w-full h-full object-cover opacity-35 filter brightness-75 scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-haw-900/20" />
      </div>
    )
  }

  <div
    class:list={[
      "relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center w-full",
      compact ? "py-2 sm:py-3" : "py-12",
    ]}
  >
    <div
      class="bg-haw-700 text-white px-6 py-5 sm:py-6 rounded-2xl shadow-2xl backdrop-blur-md border border-white/15 w-full"
    >
      <h1
        class:list={[
          "text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white",
          subtitle || Astro.slots.has("default") ? "mb-3" : "",
        ]}
      >
        {title}
      </h1>

      {
        subtitle && (
          <p class="text-haw-100/90 text-sm sm:text-base md:text-lg font-medium max-w-4xl mx-auto mb-6">
            {subtitle}
          </p>
        )
      }

      <slot />
    </div>
  </div>
</section>
