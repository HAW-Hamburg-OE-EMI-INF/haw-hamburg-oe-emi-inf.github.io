---
import type { ImageMetadata } from "astro";

interface Props {
  backgroundImage?: ImageMetadata;
  imageAlt?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
  class?: string;
}

const {
  backgroundImage,
  imageAlt,
  title,
  subtitle,
  compact = false,
  class: className = "",
} = Astro.props;
---

<section
  class:list={[
    "relative flex items-center justify-center overflow-hidden text-white",
    compact ? "bg-haw-900 py-8 sm:py-10" : "min-h-105 bg-slate-900 md:min-h-120",
    className,
  ]}
>
  {backgroundImage && (
    <div class="absolute inset-0 z-0">
      <img
        src={backgroundImage.src}
        alt={imageAlt}
        class="h-full w-full scale-105 object-cover opacity-35 brightness-75 filter"
        loading="eager"
      />
      <div class="bg-haw-900/20 absolute inset-0" />
    </div>
  )}

  <div
    class:list={[
      "relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center px-4 text-center sm:px-6",
      compact ? "py-2 sm:py-3" : "py-12",
    ]}
  >
    <div class="bg-haw-700 w-full rounded-2xl border border-white/15 px-6 py-5 text-white shadow-2xl backdrop-blur-md sm:py-6">
      <h1
        class:list={[
          "text-3xl font-black tracking-tight text-white sm:text-4xl md:text-5xl",
          subtitle || Astro.slots.has("default") ? "mb-3" : "",
        ]}
      >
        {title}
      </h1>

      {subtitle && (
        <p
          class:list={[
            "text-haw-100/90 mx-auto max-w-4xl text-sm font-medium sm:text-base md:text-lg",
            Astro.slots.has("default") ? "mb-6" : "",
          ]}
        >
          {subtitle}
        </p>
      )}

      <slot />
    </div>
  </div>
</section>
