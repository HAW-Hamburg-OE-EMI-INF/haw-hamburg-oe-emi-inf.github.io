---
import { linksByPage } from "../../data/links";
import { studiengaengeByPage } from "../../data/studiengaenge";
import { tutorNames } from "../../data/tutor-names";
import Layout from "../../layouts/Layout.astro";
import type { StudiengangPageId } from "../../types/types";
import Card from "../card/card.astro";
import Hero from "../hero/hero.astro";

export interface Props {
  studiengangPageId: StudiengangPageId;
}

const { studiengangPageId } = Astro.props;

function formatTutors(list: string[]): string {
  if (!list || list.length === 0) return "";

  list.sort();

  if (list.length === 1) return list[0];
  if (list.length === 2) return `${list[0]} und ${list[1]}`;
  return `${list.slice(0, -1).join(", ")} und ${list[list.length - 1]}`;
}

const formattedTutors = formatTutors(tutorNames[studiengangPageId]);

const studiengaenge = studiengaengeByPage[studiengangPageId];

const studiengangNames = studiengaenge.map((s) => s.name).join(" und ");
const tutorTitle = studiengaenge.map((s) => s.short).join("- und ");

const pageTitleName = studiengaenge.map((s) => `${s.name} (${s.short})`).join(" | ");

const links = linksByPage[studiengangPageId];
---

<Layout title={`${pageTitleName} - Orientierungseinheit EMI & INF`}>
  <Hero compact subtitle={`Fakultät ${studiengaenge[0].faculty.name}`} title={studiengangNames} />

  <div class="mx-auto w-full max-w-4xl space-y-6 px-4 py-10 sm:px-6">
    <Card heading=`Eure ${tutorTitle}-Tutor*innen` variant="white">
      <p class="text-base leading-relaxed text-slate-700">
        {formattedTutors || "Die Tutor*innen für diesen Studiengang werden noch bekanntgegeben."}
      </p>
    </Card>

    <Card heading="Linksammlung" variant="white">
      <ul class="list-disc space-y-3 pl-5">
        {links.map((link) => (
          <li class="leading-relaxed">
            <div>
              <a
                class="text-haw-600 hover:text-haw-800 inline-block font-medium hover:underline"
                href={link.href}
                rel="noreferrer noopener"
                target="_blank"
              >
                {link.label}
              </a>{" "}
              {link.teamsCode && (
                <span class="rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-800">
                  Teams&#x2011;Code:&nbsp;{link.teamsCode}
                </span>
              )}
            </div>
            {link.note && <span class="mt-0.5 text-sm text-slate-600">{link.note}</span>}
          </li>
        ))}
      </ul>
    </Card>
  </div>
</Layout>
