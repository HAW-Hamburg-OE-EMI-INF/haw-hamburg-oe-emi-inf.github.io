---
import MenuIcon from "../../assets/icons/menu.svg";
import CloseIcon from "../../assets/icons/x.svg";
import HeaderLogo from "./header-logo.astro";
import NavItemDesktop from "./nav-item-desktop.astro";
import NavItemMobile from "./nav-item-mobile.astro";

const navItems = [
  { label: "Start", href: "/" },
  { label: "Studiengänge", href: "/studiengang" },
  { label: "FAQ", href: "/faq" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center">
      <HeaderLogo class="justify-start" />

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-1 pl-8 md:flex">
        {navItems.map((item) => (
          <NavItemDesktop href={item.href} label={item.label} />
        ))}
      </nav>

      <div class="flex grow items-center justify-end gap-2">
        <!-- Mobile Menu Toggle Button -->
        <button
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Menü öffnen"
          class="group inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-hidden md:hidden"
          id="mobile-menu-btn"
          type="button"
        >
          <span class="sr-only">Menü umschalten</span>
          <span class="relative h-6 w-6">
            <MenuIcon class="absolute inset-0 h-6 w-6 transition-all duration-300 ease-in-out group-aria-expanded:scale-0 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0" />
            <CloseIcon class="absolute inset-0 h-6 w-6 scale-0 -rotate-90 opacity-0 transition-all duration-300 ease-in-out group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100" />
          </span>
        </button>
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="group/menu grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out data-[open=true]:grid-rows-[1fr] md:hidden"
    data-open="false"
    id="mobile-menu"
    inert
  >
    <div class="overflow-hidden border-t border-slate-200 bg-white">
      <div class="-translate-y-1 space-y-1 px-4 pt-2 pb-4 opacity-0 transition-all duration-300 ease-out group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100">
        {navItems.map((item) => (
          <NavItemMobile href={item.href} label={item.label} />
        ))}
      </div>
    </div>
  </div>
</header>

<script src="./mobile-menu.ts"></script>
