---
import ChevronDownIcon from "../../assets/icons/chevron-down.svg";

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details
  class="group open:border-haw-200 rounded-xl border border-slate-200/90 bg-white transition-all duration-150 open:shadow-xs"
  data-faq-item
>
  <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-xl px-5 py-4 font-semibold text-slate-900 select-none hover:bg-slate-50/70">
    <span class="text-sm sm:text-base">{question}</span>
    <span class="bg-haw-50 text-haw-700 group-open:bg-haw-600 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg group-open:rotate-180 group-open:text-white">
      <ChevronDownIcon class="h-4 w-4" />
    </span>
  </summary>
  <div class="faq-content border-t border-slate-100 px-5 pt-3.5 pb-4.5">
    <slot />
  </div>
</details>
