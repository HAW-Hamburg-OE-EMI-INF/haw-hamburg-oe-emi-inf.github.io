---
import type { OeInfoCardData } from "../../types/types";
import Card from "../card/card.astro";
import Hyperlink from "./hyperlink.astro";
import OeKontakt from "./oe-kontakt.astro";
import OeStartveranstaltung from "./oe-startveranstaltung.astro";
import OeStudiengaengeList from "./oe-studiengaenge-list.astro";

export interface Props {
  data: OeInfoCardData;
}

const { data } = Astro.props as Props;

const { studiengaenge, startDate, endDate, startEvent, contactEmail } = data;
---

<Card class="text-center" variant="white">
  <div class="mx-auto max-w-3xl space-y-4 text-center">
    <h3 class="text-haw-700 text-lg leading-relaxed font-semibold sm:text-xl">
      Die Orientierungseinheit der Studiengänge{" "}
      <OeStudiengaengeList studiengaenge={studiengaenge} /> findet vom{" "}
      <strong class="text-haw-800 font-bold">
        {startDate} bis zum {endDate}
      </strong>{" "}
      statt.
    </h3>

    <p class="text-base leading-relaxed font-medium text-slate-800 sm:text-lg">
      <OeStartveranstaltung startEvent={startEvent} />
    </p>

    <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
      Während der Orientierungswoche werden wir euch mit allen Infos rund ums Studium versorgen und
      euch die Möglichkeit geben, euch zu vernetzen, eine Menge Spaß zu haben und eure Fragen
      beantwortet zu bekommen.
    </p>

    <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
      Falls du vorab schon Fragen hast schau auf unsere <Hyperlink href="/faq">FAQ-Seite</Hyperlink>{" "}
      oder schreib uns eine Mail an: <OeKontakt email={contactEmail} />
    </p>

    <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
      Eine kleine Linksammlung und erste Informationen für die jeweiligen Studiengänge kannst du
      außerdem unter <Hyperlink href="/studiengang">Studiengänge</Hyperlink> finden.
    </p>

    <p class="text-haw-700 text-base font-semibold sm:text-lg">Wir freuen uns auf euch :)</p>
  </div>
</Card>
